<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Feel Stress Free</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <style>
    body{
      margin:0;
      font-family: Arial, sans-serif;
      background:#0f172a;
      color:#ffffff;
      display:flex;
      justify-content:center;
      align-items:center;
      height:100vh;
      text-align:center;
    }
    .box{
      max-width:600px;
      padding:30px;
      border-radius:12px;
      background:#020617;
      box-shadow:0 0 25px rgba(0,255,200,0.15);
    }
    h1{
      color:#22c55e;
      margin-bottom:10px;
    }
    p{
      font-size:18px;
      line-height:1.6;
      color:#e5e7eb;
    }
  </style>
</head>
<body>
  <div class="box">
    <h1>Feel Stress Free 🌿</h1>
    <p>
      Welcome to Feel Stress Free.<br>
      Calm your mind, relax your thoughts,<br>
      and live peacefully every day.
    </p>
  </div>
</body>
</html>
